{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(bin/job *)",
      "Bash(./bin/job *)",
      "Bash(job *)",
      "Bash(python3 -m unittest *)",
      "Bash(python scripts/*)",
      "Bash(py -3 scripts/*)",
      "Bash(bin\\job *)",
      "Bash(python -m unittest *)",
      "Bash(py -3 -m unittest *)",
      "Read(./candidates/**)",
      "Read(./templates/**)",
      "Read(./learn/**)"
    ],
    "ask": [
      "Edit(./hooks/**)",
      "Edit(./scripts/gates.py)",
      "Edit(./bin/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./hooks/**)",
      "Write(./scripts/gates.py)",
      "Write(./bin/**)",
      "Write(./.claude/settings.json)",
      "Write(./.claude/settings.local.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.browser/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/hooks/py.sh\" \"$CLAUDE_PROJECT_DIR/scripts/status.py\" --context",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/hooks/py.sh\" \"$CLAUDE_PROJECT_DIR/hooks/gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
