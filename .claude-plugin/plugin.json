{
  "name": "job-harness",
  "version": "0.2.2",
  "description": "A Claude Code harness for job seekers: intake, tailored CV and letters, daily job discovery and rule-abiding applications, with sealed approvals and a dry-run default.",
  "author": {
    "name": "100FOUNTS",
    "url": "https://github.com/100FOUNTS"
  },
  "homepage": "https://github.com/100FOUNTS/job-harness",
  "repository": "https://github.com/100FOUNTS/job-harness",
  "license": "MIT",
  "keywords": [
    "job-search",
    "applications",
    "cv",
    "seek",
    "linkedin",
    "australia"
  ],
  "skills": [
    "./.claude/skills/"
  ],
  "agents": [
    "./.claude/agents/form-filler.md",
    "./.claude/agents/job-triager.md",
    "./.claude/agents/profile-auditor.md",
    "./.claude/agents/tailor-reviewer.md",
    "./.claude/agents/tailor-writer.md"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/status.py\" --context",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
